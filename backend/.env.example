# ==========================================
# CONTOH FILE KONFIGURASI (.env)
# Salin file ini menjadi ".env" lalu isi nilainya.
# JANGAN pernah upload file .env asli ke GitHub!
# ==========================================

# Port server (website dibuka di http://localhost:3000)
PORT=3000

# Email Gmail yang dipakai untuk MENGIRIM email
EMAIL_USER=hzikri86@gmail.com

# App Password Gmail (16 karakter, BUKAN password Gmail biasa)
EMAIL_PASS=abcdefghijklmnop

# Email admin yang MENERIMA data pendaftaran
ADMIN_EMAIL=hzikri86@gmail.com

# Akun demo untuk login ke website
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123
